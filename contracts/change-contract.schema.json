{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroai.dev/schemas/change-contract.json",
  "title": "ZeroAI Change Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "goal",
    "requirementIds",
    "allowedPaths",
    "protectedPaths",
    "invariants",
    "acceptanceCriteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "protectedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "prohibitedChanges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

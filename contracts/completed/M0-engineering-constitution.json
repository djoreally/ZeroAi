    "TEL-001",
    "MAIL-001",
    "DB-001",
    "SCOPE-001",
    "CERT-001",
    "REL-001"
  ],
  "allowedPaths": [
    "zeroai.constitution.yaml",
    "architecture.registry.json",
    "requirements/**",
    "decisions/**",

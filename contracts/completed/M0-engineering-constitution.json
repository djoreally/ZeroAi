    {
      "id": "M0-AC-002",
      "description": "Forbidden runtime providers and database drivers are absent.",
      "evidence": [
        "negative architecture scan exit 0"
      ]
    },
    {
      "id": "M0-AC-003",
      "description": "Existing typecheck, tests and production build still pass.",
      "evidence": [
        "GitHub Actions zeroai-certification"
      ]
